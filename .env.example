# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file.

# --- Required ---
# Your bot token from https://discord.com/developers/applications
#   -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# --- Optional ---
# Only watch specific channels (comma-separated channel IDs).
# Turn on Developer Mode in Discord, right-click a channel -> Copy Channel ID.
# Leave blank to watch every channel the bot can read.
MONITOR_CHANNEL_IDS=

# ===== Stock-checker (Option B: `npm run stock`) =====
# Best Buy official API key — free at https://developer.bestbuy.com/
BESTBUY_API_KEY=

# Target RedSky public web key override (only set if the built-in default stops
# working — grab a fresh one from target.com network requests).
TARGET_API_KEY=

# How often to poll retailers, in seconds (minimum 30, default 120).
STOCK_POLL_SECONDS=120
